<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script defer src="/public/js/shellyAddClient.js"></script>
    <title>Shelly Registration</title>
</head>

<body>

</body>
<a href="/home">
    <button>Go to home</button>
</a>
<br><br>
<button id="ws_test_button">ws test button</button>
{{#if shelly_devices}}
<form action="/api/v1/shellyAdd" method="post">

    <select name="shelly_device" required>
        <option disabled> Select a Shelly Device</option>
        {{#each shelly_devices}}

        <option value="{{this.address}}">

            {{this.id}}

            {{this.ws.server}}</option>
        {{/each}}
    </select>
    <br>
    <input type="submit" value="Register Shelly" />
</form>
{{else}}

<p>No shellies to be configured yet</p>

{{/if}}
<br><br>

<a href="/api/v1/refresher">
    <button>Refresh list</button>
</a>

</html>