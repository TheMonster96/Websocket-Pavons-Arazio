<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script defer src="/public/js/shellyAddClient.js"></script>
    <title>Shelly Registration</title>
</head>

<body>

</body>
<a href="/home">
    <button>Go to home</button>
</a>
<br><br>
{{#if shelly_devices}}
<form action="/api/v1/shellyAdd" method="post">
    <p> Select a shelly device</p>
    <select name="shelly_device" id="shelly_devices" required>

        {{#each shelly_devices}}

        <option value="{{this.address}}">

            {{this.id}}

            {{this.ws.server}}</option>
        {{/each}}
    </select>
    <br>
    <input type="submit" value="Register Shelly" />
</form>
{{else}}

<p>No shellies to be configured yet</p>

{{/if}}
<br><br>

<form action="/api/v1/refresher" method="GET">
    <input type="Submit" Value="Refresh List" />
</form>

</html>